import base64
import os

print("=== Identificador e Descriptografador Universal ===")

caminho = input("Digite o caminho completo do arquivo (ex: /storage/emulated/0/Download/save.txt): ")

if not os.path.exists(caminho):
    print("❌ Arquivo não encontrado:", caminho)
else:
    try:
        # Lê o conteúdo do arquivo
        with open(caminho, "r") as f:
            conteudo = f.read().strip()

        # Remove espaços e quebras de linha
        conteudo_limpo = conteudo.replace(" ", "").replace("\n", "")

        # Detecta o tipo de conteúdo
        tipo = None
        dados = None

        # Testa se é hexadecimal
        if all(c in "0123456789ABCDEFabcdef" for c in conteudo_limpo):
            tipo = "hexadecimal"
            dados = bytes.fromhex(conteudo_limpo)

        # Testa se é Base64
        else:
            try:
                dados = base64.b64decode(conteudo_limpo, validate=True)
                tipo = "base64"
            except Exception:
                tipo = "texto"
                dados = conteudo.encode("utf-8")

        print(f"🔍 Tipo detectado: {tipo}")

        # Tenta converter para texto legível
        try:
            texto = dados.decode("utf-8")
            extensao = ".txt"
            modo = "w"
        except Exception:
            texto = dados
            extensao = ".bin"
            modo = "wb"

        # Cria arquivo de saída
        novo_arquivo = os.path.join(os.path.dirname(caminho), "descriptografado" + extensao)
        with open(novo_arquivo, modo) as f:
            f.write(texto)

        print(f"✅ Arquivo convertido com sucesso: {novo_arquivo}")

    except Exception as e:
        print("❌ Erro ao processar o arquivo:", e)
