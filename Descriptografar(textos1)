        return

    # Base64
    resultado = base64_decode(texto)

    if resultado:

        print("\n[+] Tipo: Base64")
        print("[+] Resultado:")
        print(resultado)

        return

    # HEX
    resultado = hexadecimal(texto)

    if resultado:

        print("\n[+] Tipo: HEX")
        print("[+] Resultado:")
        print(resultado)

        return

    # César
    resultado = procurar_cesar(texto)

    if resultado:

        pontos, deslocamento, resultado_texto = resultado

        print("\n[+] Possível cifra de César")
        print("[+] Deslocamento:", deslocamento)
